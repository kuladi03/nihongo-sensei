# ==============================================================================
# Nihongo Sensei Environment Configuration Template
# Copy to .env and configure your secret credentials before running.
# ==============================================================================

# 1. Notion API Integration
NOTION_TOKEN=secret_your_notion_internal_integration_token_here
NOTION_PAGE_ID=41d1f226830e816891a7cebe4ff5e0f6
NOTION_SYNC_INTERVAL_MINUTES=15

# 2. Google Gemini Live & LLM APIs (AI Studio - Free Tier)
GEMINI_API_KEY=your_free_google_ai_studio_key_here

# 3. Persistent Cloud SQLite via Turso (Leave blank to use local db/nihongo.db)
TURSO_DATABASE_URL=libsql://your-turso-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token

# 4. Authentication & Security
JWT_SECRET=your_random_64_character_hex_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
ADMIN_EMAIL=admin@example.com

# 5. Local Storage & Server Port
DATABASE_PATH=db/nihongo.db
PORT=8000
